# ===== Workforce Dashboard Configuration =====

# Database URL.
# For PostgreSQL (recommended for production):
#   postgresql://USER:PASSWORD@HOST:5432/workforce
# For local testing without PostgreSQL, you can use SQLite:
#   sqlite:///workforce.db
# For free cloud hosting (Render), leave this as-is in render.yaml and paste
# the "postgresql://..." connection string from a free Neon/PostgreSQL DB.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/workforce

# Login password for the dashboard (change this!)
DASHBOARD_PASSWORD=admin123

# Secret key used for session cookies (change this to a random string)
SECRET_KEY=change-me-to-a-random-secret

# Port the web server listens on
PORT=5000